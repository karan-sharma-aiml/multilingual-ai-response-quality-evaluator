    {
      "name": "Evaluate (rule engine + Gemini)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/evaluate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "evaluate"
          ]
        },
        "description": "Falls back to rule_based (see gemini.error) when GEMINI_API_KEY is missing or Gemini fails.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What is cloud computing?\",\n  \"response\": \"Cloud computing means renting servers, storage and software over the internet instead of owning hardware. Companies pay only for what they use.\",\n  \"language\": \"English\",\n  \"reference_answer\": \"Cloud computing delivers computing services over the internet on a pay-as-you-go basis.\",\n  \"category\": \"Technology\",\n  \"use_gemini\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.environment.set('result_id', body.id);",
              "pm.test('Has overall score', () => pm.expect(body.overall_score).to.be.within(0, 100));",
              "pm.test('Method present', () => pm.expect(['hybrid','rule_based']).to.include(body.evaluation_method));"
            ]
          }
        }
      ]
    },
