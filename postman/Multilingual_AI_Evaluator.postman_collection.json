    {
      "name": "Batch evaluate (CSV upload)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/batch-evaluate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "batch-evaluate"
          ]
        },
        "description": "Select datasets/batch_sample.csv in the file field. The last row is intentionally invalid.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "datasets/batch_sample.csv"
            },
            {
              "key": "use_gemini",
              "value": "false",
              "type": "text"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('Counts add up', () => pm.expect(b.success_count + b.failed_count).to.eql(b.total_records));"
            ]
          }
        }
      ]
    },
