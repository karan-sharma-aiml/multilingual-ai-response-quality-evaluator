# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
APP_NAME="Multilingual AI Response Quality Evaluator"
# development | test | production  (production forbids CORS_ORIGINS=*)
APP_ENV=development
DEBUG=false
ENABLE_DOCS=true
# Set false when the container entrypoint creates tables (multi-worker safe)
AUTO_CREATE_TABLES=true

# ---------------------------------------------------------------------------
# Database (SQLite by default, PostgreSQL for production)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./evaluator.db
# DATABASE_URL=postgresql+psycopg2://evaluator:change-me@localhost:5432/evaluator
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Logging (DEBUG | INFO | WARNING | ERROR | CRITICAL)
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Comma-separated API keys. Empty = authentication disabled (development only!)
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Comma-separated allowed origins, e.g. https://app.example.com
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Trust X-Forwarded-For (only behind a reverse proxy you control)
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Performance
# ---------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=256
MAX_BATCH_ROWS=500
MAX_UPLOAD_BYTES=5242880
GEMINI_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Gemini (leave GEMINI_API_KEY empty to use the rule-based engine only)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=1.0
GEMINI_MAX_RETRY_DELAY_SECONDS=10
# Share of the Gemini score in the merged result (0-1)
GEMINI_WEIGHT=0.6
GEMINI_MAX_INPUT_CHARS=6000

# ---------------------------------------------------------------------------
# Analytics & reports
# ---------------------------------------------------------------------------
LOW_QUALITY_THRESHOLD=50
REPORT_MAX_ROWS=10000
REPORT_PDF_MAX_ROWS=500
# TrueType font for PDF reports (needs the glyphs you want to print)
# REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------
POSTGRES_DB=evaluator
POSTGRES_USER=evaluator
POSTGRES_PASSWORD=change-me
API_PORT=8000
WEB_CONCURRENCY=2
